# UI BINDER - environment template.
# Copy to .env ONLY for local dev. NEVER commit .env with real keys.

# Optional: vision provider compatible with OpenAI-style multimodal APIs.
# Leave empty to run fully local (LocalHeuristicVisionProvider is the default).
UIBINDER_VISION_BASE_URL=
UIBINDER_VISION_MODEL=
UIBINDER_VISION_API_KEY=

# Local server binding (dev).
UIBINDER_HOST=127.0.0.1
UIBINDER_PORT=8765

# Data root override. Default: %LOCALAPPDATA%/UIBinder
UIBINDER_DATA_DIR=

# Generación de imágenes con IA (opcional, compatible OpenAI /images/generations).
# Sin configurar: los héroes IA quedan deshabilitados y las herramientas de
# fondo locales siguen funcionando sin nube.
UIBINDER_IMAGEGEN_BASE_URL=
UIBINDER_IMAGEGEN_MODEL=
UIBINDER_IMAGEGEN_API_KEY=
